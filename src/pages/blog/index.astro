---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog">
  <section class="container blog-index">

    <h1>Recent Entries</h1>

    {posts.map((post) => (
      <article class="post-preview">

        <div class="post-content">

          <p class="category">
            {post.data.category}
          </p>

          <h2>
            <a href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
          </h2>

          <p>{post.data.description}</p>

          <a href={`/blog/${post.id}/`}>
            Read More →
          </a>

        </div>

        {post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? ""}
            loading="lazy"
          />
        )}

      </article>
    ))}

  </section>
</BaseLayout>

<style>
  .blog-index {
    padding-top: 3rem;
  }

  .post-preview {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;

    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-preview h2 {
    margin: 0.5rem 0;
  }

  .post-preview h2 a {
    text-decoration: none;
  }

  .category {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .post-preview img {
    width: 300px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .post-preview {
      grid-template-columns: 1fr;
    }

    .post-preview img {
      width: 100%;
    }
  }
</style>