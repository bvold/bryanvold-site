---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const page = await getEntry("pages", "contact");

if (!page) {
  throw new Error("Content not found: contact.md");
}

const { Content } = await render(page);

// Cloudflare's always-pass test key in dev; the real key in production.
const turnstileSiteKey = import.meta.env.DEV
  ? "1x00000000000000000000AA"
  : siteConfig.contact.turnstileSiteKey;
---

<BaseLayout
  title={page.data.title}
  description="Get in touch with Bryan Vold."
>
  <section class="container contact-page">
    <h1>{page.data.title}</h1>

    <div class="intro">
      <Content />
    </div>

    <form id="contact-form" class="contact-form" novalidate>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
        <p class="field-error" data-error-for="name" aria-live="polite"></p>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
        <p class="field-error" data-error-for="email" aria-live="polite"></p>
      </div>

      <div class="field">
        <label for="reason">What's this about?</label>
        <select id="reason" name="reason" required>
          {siteConfig.contact.reasons.map((reason) => (
            <option value={reason}>{reason}</option>
          ))}
        </select>
        <p class="field-error" data-error-for="reason" aria-live="polite"></p>
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="8" required minlength="10" maxlength="5000"></textarea>
        <p class="field-error" data-error-for="message" aria-live="polite"></p>
      </div>

      <!-- Honeypot: hidden from people; bots tend to fill it in. -->
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
      <p class="field-error" data-error-for="cf-turnstile-response" aria-live="polite"></p>

      <button type="submit" class="button">Send Message</button>

      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>

    <div id="form-success" class="form-success" hidden tabindex="-1">
      <h2>Thank you!</h2>
      <p>Your message is on its way. I'll get back to you as soon as I can.</p>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script>
  import { actions, isInputError } from "astro:actions";

  declare const turnstile: { reset: () => void } | undefined;

  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const status = document.querySelector<HTMLElement>("#form-status")!;
  const success = document.querySelector<HTMLElement>("#form-success")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

  const clearErrors = () => {
    form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
      el.textContent = "";
    });
    form.querySelectorAll("[aria-invalid]").forEach((el) =>
      el.removeAttribute("aria-invalid"),
    );
    status.textContent = "";
    status.classList.remove("is-error");
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearErrors();

    button.disabled = true;
    button.textContent = "Sending…";

    const { error } = await actions.contact(new FormData(form));

    button.disabled = false;
    button.textContent = "Send Message";

    if (!error) {
      form.hidden = true;
      success.hidden = false;
      success.focus();
      return;
    }

    if (isInputError(error)) {
      let firstInvalid: HTMLElement | null = null;
      for (const [field, messages] of Object.entries(error.fields)) {
        const target = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (target && messages?.length) target.textContent = messages[0];
        const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
        if (input) {
          input.setAttribute("aria-invalid", "true");
          firstInvalid ??= input;
        }
      }
      firstInvalid?.focus();
    } else {
      status.textContent = error.message;
      status.classList.add("is-error");
    }

    // Turnstile tokens are single-use; get a fresh one for the next try.
    if (typeof turnstile !== "undefined") turnstile.reset();
  });
</script>

<style>
  .contact-page {
    max-width: 720px;
    padding-block: 4rem;
  }

  .intro {
    margin-bottom: 2.5rem;
  }

  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  label {
    font-weight: 600;
    color: var(--color-forest);
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid #c9cbc2;
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
  }

  textarea {
    resize: vertical;
    min-height: 10rem;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 1px;
    border-color: var(--color-forest);
  }

  [aria-invalid="true"] {
    border-color: #a33a2b;
  }

  .field-error,
  .form-status.is-error {
    color: #a33a2b;
    font-size: 0.95rem;
    margin: 0;
  }

  .field-error:empty,
  .form-status:empty {
    display: none;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .button {
    justify-self: start;
    font: inherit;
    background: var(--color-forest);
    color: var(--color-cream);
    border: 1px solid var(--color-forest);
    padding: 0.8rem 1.75rem;
    cursor: pointer;
  }

  .button:hover:not(:disabled) {
    background: var(--color-forest-hover);
  }

  .button:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .form-success {
    background: var(--color-cream);
    border-left: 4px solid var(--color-forest);
    padding: 1.5rem 1.75rem;
  }

  .form-success:focus {
    outline: none;
  }

  .form-success h2 {
    margin-top: 0;
  }
</style>
