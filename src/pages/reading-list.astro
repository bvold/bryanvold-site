---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection, getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'reading-list');
if (!page) {
  throw new Error('Content not found: reading-list.md');
}
const { Content } = await render(page);

const books = await getCollection('books');
const sections = [
  { status: 'reading', heading: 'Currently Reading', tone: 'sage' },
  { status: 'want', heading: 'Want to Read', tone: 'blue' },
  { status: 'read', heading: 'Books I’ve Read', tone: 'cream' },
] as const;
const ratingLabel = (rating: number) => `${rating.toFixed(1).replace(/\.0$/, '')} / 5`;
const ratingStars = (rating: number) => '★'.repeat(Math.floor(rating)) + (rating % 1 >= .5 ? '½' : '') + '☆'.repeat(5 - Math.ceil(rating));
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="page">
    <PageHeader title={page.data.title}>
      <div class="lead intro"><Content /></div>
    </PageHeader>
    {sections.map(section => {
      const items = books.filter(book => book.data.status === section.status)
        .sort((a,b) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.title.localeCompare(b.data.title));
      return <section class={`book-section ${section.tone}`} aria-label={section.heading}>
        <h2>{section.heading}</h2>
        {items.length ? <ul class="book-list">
          {items.map(book => <li class="book-item">
            <div class="book-heading"><cite>{book.data.title}</cite><span class="separator"> — </span><span class="author">{book.data.author}</span></div>
            {section.status === 'read' && book.data.rating != null && <p class="rating" aria-label={`My rating: ${ratingLabel(book.data.rating)}`}><span aria-hidden="true">{ratingStars(book.data.rating)}</span> <span class="rating-number">{ratingLabel(book.data.rating)}</span></p>}
            {book.data.impression && <p class="impression">{book.data.impression}</p>}
          </li>)}
        </ul> : <p class="empty">No books here yet.</p>}
      </section>;
    })}
  </div>
</BaseLayout>
<style>
  .intro { margin-top: .75rem; }
  .intro :global(p) { margin: 0 0 .75rem; }
  .intro :global(p:last-child) { margin-bottom: 0; }
  .book-section { margin: 0 0 2.5rem; }
  .book-section h2 { padding: .75rem 1rem; margin: 0; border-radius: 5px 5px 0 0; color: var(--color-forest); }
  .sage h2 { background: #e3ebe0; }
  .blue h2 { background: #e7edf0; }
  .cream h2 { background: #f1eadc; }
  .book-list { list-style: none; padding: 0; margin: 0; }
  .book-item { padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .book-heading { overflow-wrap: anywhere; }
  .book-heading cite { font-style: italic; font-weight: 600; }
  .author { color: var(--color-muted); }
  .rating { margin: .35rem 0 0; color: #42664c; letter-spacing: .035em; }
  .rating-number { font-size: var(--text-sm); letter-spacing: 0; margin-left: .4rem; }
  .impression { margin: .35rem 0 0; color: var(--color-muted); }
  .empty { margin: 0; padding: 1rem; color: var(--color-muted); }
  @media (max-width: 520px) { .book-item, .empty { padding-inline: .25rem; } }
</style>
