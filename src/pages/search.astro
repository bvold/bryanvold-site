---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search"
  description="Search the writing and articles of Bryan Vold."
>

  <section class="search-page container">

    <header class="search-header">

      <p class="eyebrow">
        EXPLORE THE JOURNAL
      </p>

      <h1>Search</h1>

      <p class="introduction">
        Search through my articles, observations,
        and reflections.
      </p>

    </header>

    <div class="search-interface">

      <pagefind-input
        instance="full-page"
        placeholder="What are you looking for?"
      ></pagefind-input>

      <pagefind-summary
        instance="full-page"
      ></pagefind-summary>

      <pagefind-results
        instance="full-page"
      ></pagefind-results>

    </div>

  </section>

</BaseLayout>

<style>
  .search-page {
    max-width: 850px;
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .search-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-forest);
  }

  .search-header h1 {
    margin: 0.5rem 0 1rem;
    color: var(--color-forest);
  }

  .introduction {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 600px;
  }

  .search-interface {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  pagefind-input {
    display: block;
    margin-bottom: 1.5rem;
  }

  pagefind-summary {
    display: block;
    margin-bottom: 1rem;
  }
</style>