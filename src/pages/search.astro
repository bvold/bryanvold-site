---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search">

  <section class="container search-page">

    <h1>Search</h1>

    <p>
      Search articles, ideas, and other writing.
    </p>

    <div id="search"></div>

  </section>

  <link
    href="/pagefind/pagefind-ui.css"
    rel="stylesheet"
  />

  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      new PagefindUI({
        element: "#search",
        showSubResults: true
      });
    });
  </script>

  <script
    is:inline
    src="/pagefind/pagefind-ui.js"
  ></script>

</BaseLayout>

<style>
  .search-page {
    max-width: 800px;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
</style>