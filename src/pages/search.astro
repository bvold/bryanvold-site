---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search"
  description="Search articles and writing by Bryan Vold."
>
  <section class="search-page container">

    <header class="search-header">
      <p class="eyebrow">EXPLORE THE JOURNAL</p>

      <h1>Search</h1>

      <p>
        Looking for something particular?
        Search through my articles, ideas,
        and observations.
      </p>
    </header>

    <div class="search-container">
      <pagefind-input
        placeholder="Search the journal..."
      ></pagefind-input>

      <pagefind-summary></pagefind-summary>

      <pagefind-results></pagefind-results>
    </div>

  </section>

  <link
    rel="stylesheet"
    href="/pagefind/pagefind-component-ui.css"
  />

  <script
    type="module"
    src="/pagefind/pagefind-component-ui.js"
  ></script>
</BaseLayout>

<style>
  .search-page {
    max-width: 850px;
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .search-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: var(--color-forest);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  .search-header h1 {
    margin: 0.5rem 0 1rem;
  }

  .search-header p {
    max-width: 600px;
    color: var(--color-muted);
  }

  .search-container {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .search-container pagefind-input {
    display: block;
    margin-bottom: 1.5rem;
  }
</style>