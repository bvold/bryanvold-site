---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout
  title="Search"
  description="Search the writing and articles of Bryan Vold."
>
  <section class="page">

    <PageHeader
      title="Search"
      eyebrow="Explore the Journal"
      lead="Search through my articles, observations, and reflections."
    />

    <div class="search-interface">
      <pagefind-input
        instance="full-page"
        placeholder="What are you looking for?"
      ></pagefind-input>

      <pagefind-summary
        instance="full-page"
      ></pagefind-summary>

      <pagefind-results
        instance="full-page"
      ></pagefind-results>
    </div>

  </section>
</BaseLayout>

<style>
  .search-interface {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  pagefind-input {
    display: block;
    margin-bottom: 1.5rem;
  }

  pagefind-summary {
    display: block;
    margin-bottom: 1rem;
  }
</style>
