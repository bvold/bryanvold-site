---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../utils/format";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
)
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() -
      a.data.pubDate.valueOf()
  )
  .slice(0, 6);
---

<BaseLayout>

  <section class="welcome container page-wide">
    <p class="eyebrow">Welcome</p>

    <h1>Random thoughts on writing, discovery and observations.</h1>

    <blockquote class="verse">
      <p>The heart of man plans his way, but the Lord establishes his steps.</p>
      <cite>Proverbs 16:9</cite>
    </blockquote>

    <a class="button" href="/blog/">
      Read the Blog →
    </a>
  </section>

  <section class="recent container">

    <div class="section-heading">
      <h2>Latest Articles</h2>

      <a class="read-more" href="/blog/">
        View All Posts →
      </a>
    </div>

    <div class="article-grid">
      {posts.map((post) => (
        <article>

          {post.data.image && (
            <img
              src={post.data.image}
              alt={post.data.imageAlt ?? ""}
              loading="lazy"
            />
          )}

          <p class="eyebrow">{post.data.category}</p>

          <h3 class="post-title">
            <a href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
          </h3>

          <p class="meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </p>

          <p class="description">{post.data.description}</p>

          <a class="read-more" href={`/blog/${post.id}/`}>
            Read More →
          </a>

        </article>
      ))}
    </div>

  </section>

</BaseLayout>

<style>
  .welcome {
    padding-bottom: 4rem;
  }

  .welcome h1 {
    max-width: 18em;
    margin: 0;
  }

  .verse {
    max-width: 34em;
    margin: 1.75rem 0 2rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-border);
  }

  .verse p {
    margin: 0;
    font-size: var(--text-lead);
    font-style: italic;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .verse cite {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    font-style: normal;
    letter-spacing: 0.05em;
    color: var(--color-forest);
  }

  .button {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border: 1px solid var(--color-forest);
    text-decoration: none;
    color: var(--color-forest);
  }

  .button:hover,
  .button:focus-visible {
    background: var(--color-forest);
    color: var(--color-cream);
  }

  .recent {
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .article-grid img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 1rem;
  }

  .article-grid .meta {
    margin: 0 0 0.75rem;
  }

  .description {
    margin: 0 0 0.75rem;
  }

  @media (max-width: 800px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .welcome {
      padding-bottom: 3rem;
    }
  }
</style>
