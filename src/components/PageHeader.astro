---
/*
 * Shared page title block: optional small-caps label, the page's h1,
 * an optional intro line, and an optional slot (e.g. a post date).
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>
